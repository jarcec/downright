<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Settings live in ~/.config/downright.toml so they can be shared with chezmoi.
	     Temporary exceptions are frequently rejected by App Store review; before
	     submission this must become a one-time user grant (security-scoped bookmark).
	     See TRD §9. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/.config/</string>
	</array>
</dict>
</plist>
