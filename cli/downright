#!/bin/sh
# downright — open Markdown files in Downright.app from the shell.
#
# Fire-and-forget: hands the paths to the app through Launch Services and exits
# immediately. Not suitable as $EDITOR. Nonexistent paths are created empty
# first, because this shim runs outside the app's sandbox and the app cannot
# create files at arbitrary locations itself (plan decision D3).

set -eu

# Resolve the app: the bundle this script ships inside (Contents/Resources/downright),
# else the installed copy, else by name (Launch Services may otherwise pick a build
# product with the same bundle identifier).
APP="Downright"
SELF=$(readlink "$0" 2>/dev/null || echo "$0")
case "$SELF" in /*) ;; *) SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$SELF")" ;; esac
BUNDLE=$(cd "$(dirname "$SELF")/../.." 2>/dev/null && pwd)
if [ -n "$BUNDLE" ] && [ -f "$BUNDLE/Contents/Info.plist" ]; then APP="$BUNDLE"
elif [ -d /Applications/Downright.app ]; then APP="/Applications/Downright.app"; fi
VERSION=$(defaults read "$APP/Contents/Info" CFBundleShortVersionString 2>/dev/null || echo "dev")

usage() {
  cat <<USAGE
usage: downright [-p] [-n] [FILE...]

  FILE        open FILE (created empty if it does not exist). Each file opens
              in its own new window.
  -p          open the given files as tabs of one new window, e.g. downright -p *.md
  -n, --new   activate the app (creates an untitled document if none is open)
  -v          print version
  -h          this help
USAGE
}

if [ $# -eq 0 ]; then
  usage; exit 1
fi

TABS=0
files=""
for arg in "$@"; do
  case "$arg" in
    -h|--help)    usage; exit 0 ;;
    -v|--version) echo "downright $VERSION"; exit 0 ;;
    -n|--new)     open -a "$APP" || exit 2; exit 0 ;;
    -p)           TABS=1; continue ;;
    -*)           echo "downright: unknown option: $arg" >&2; usage; exit 1 ;;
  esac
  case "$arg" in
    /*) path="$arg" ;;
    *)  path="$PWD/$arg" ;;
  esac
  if [ ! -e "$path" ]; then
    dir=$(dirname "$path")
    if [ ! -d "$dir" ]; then
      echo "downright: no such directory: $dir" >&2; exit 1
    fi
    : > "$path"
  fi
  files="$files
$path"
done

if [ "$TABS" = 1 ]; then
  # One open request → one window with tabs.
  printf '%s\n' "$files" | sed '/^$/d' | tr '\n' '\0' | xargs -0 open -a "$APP" || exit 2
else
  # One request per file → one window per file.
  printf '%s\n' "$files" | sed '/^$/d' | while IFS= read -r f; do
    open -a "$APP" "$f" || exit 2
  done
fi
exit 0
